# Solana & RPC Provider
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# PumpPortal WebSocket
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# Filter Thresholds (Hipotesis Awal)
MAX_DEV_BUY_PCT=10.0
MAX_SNIPER_BUNDLE_PCT=25.0
MIN_LP_LOCKED_PCT=90.0
MAX_TOP10_HOLDERS_PCT=30.0
RPC_CONCURRENCY_LIMIT=15
